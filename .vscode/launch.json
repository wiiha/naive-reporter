{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: naive-reporter (ingest)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/naive_reporter/__main__.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Python Debugger: naive-reporter-search",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/naive_reporter/search_cli.py",
      "args": ["${input:searchQuery}", "--show-summary"],
      "console": "integratedTerminal"
    },
    {
      "name": "Python Debugger: naive-reporter-report",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/naive_reporter/report_cli.py",
      "args": ["${input:reportPrompt}"],
      "console": "integratedTerminal"
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "searchQuery",
      "type": "promptString",
      "description": "Enter your search query",
      "default": ""
    },
    {
      "id": "reportPrompt",
      "type": "promptString",
      "description": "Enter your report prompt",
      "default": ""
    }
  ]
}
